#include <windows.h>

// Application Icon
1 ICON "app_icon.ico"

// Application Manifest
1 RT_MANIFEST "rx_player.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,7,1,0
PRODUCTVERSION  2,7,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "RX Media Player\0"
            VALUE "FileDescription",  "RX Media Player\0"
            VALUE "FileVersion",      "2.7.1.0\0"
            VALUE "InternalName",     "rx_player\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 RX Media Player. All rights reserved.\0"
            VALUE "OriginalFilename", "rx_player.exe\0"
            VALUE "ProductName",      "RX Media Player\0"
            VALUE "ProductVersion",   "2.7.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
